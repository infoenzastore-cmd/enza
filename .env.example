# ENZA Testnet checkout environment.
#
# The public Testnet identity (contract ID, USDC issuer and merchant address)
# defaults to the VERIFIED deployment recorded in contracts/deployments/ — the
# service re-verifies it against the live chain at every startup and refuses to
# start on any mismatch. Set these overrides only when pointing at a different
# verified deployment:
#
# STELLAR_USDC_TESTNET_ISSUER=
# STELLAR_MERCHANT_ADDRESS=
# STELLAR_CHECKOUT_CONTRACT_ID=
#
# Server-side operator (contract admin) Testnet key for on-chain order
# creation. This is the ONLY required variable: the contract enforces admin
# authorization for create_order, and it must never be committed, never sent
# to the browser, and never placed here with a real value.
STELLAR_CHECKOUT_OPERATOR_SECRET=
# Optional Stellar RPC override; Pubnet endpoints are refused at startup.
# STELLAR_RPC_URL=
PORT=3000

# Optional: override the local order-store directory (used by automated tests so
# they never write the operator's real demo store). Defaults to ./.data/.
# ENZA_DATA_DIR=
